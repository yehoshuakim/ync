{
  "name": "standin-apphost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "aspire:restore": "aspire restore --non-interactive",
    "aspire:start": "aspire run",
    "aspire:build": "npm run aspire:restore && tsc -p tsconfig.apphost.json",
